{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "outDir": "./dist",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"],
    "rootDir": ".",
    "moduleResolution": "nodenext"
  },
  "include": ["src/**/*", "src/**/*.json"],
  "exclude": ["src/**/*.spec.ts"]
}
