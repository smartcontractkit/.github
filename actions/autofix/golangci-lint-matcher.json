{
  "problemMatcher": [
    {
      "owner": "autofix-golangci-lint",
      "pattern": [
        {
          "regexp": "^([^\\s:][^:]*):(\\d+):(?:(\\d+):)? (.+) \\(([\\w-]+)\\)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4,
          "code": 5
        }
      ]
    }
  ]
}
